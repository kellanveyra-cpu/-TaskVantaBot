# ============================================================
# TaskVanta - Environment Variables
# Copy this file to ".env" for local development.
# On Railway, set these under Project -> Variables instead.
# ============================================================

# --- REQUIRED ---
BOT_TOKEN=
ADMIN_IDS=
BOT_USERNAME=

# --- OPTIONAL (sensible defaults are used if omitted) ---
DB_PATH=taskvanta.db
DEFAULT_TASK_REWARD=1.0
REFERRAL_REWARD=10.0
MIN_WITHDRAWAL=130.0
PROJECT_NAME=TaskVanta
DEMO_MODE=true
